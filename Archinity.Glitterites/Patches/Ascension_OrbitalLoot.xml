<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- ====================================================================
       LOOSE GLITTERHEARTS FROM ORBITAL QUESTS

       Odyssey's Reward_GravshipUpgrade is a ThingSetMaker_RandomOption.
       Two ORBITAL quests draw from it:

           Script_OrbitalFugitive.xml:113   OrbitalFugitivePlatform
           Script_Site.xml:177              orbital survey sites

       Adding an option is ADDITIVE. FuelOptimizer and GravshipShieldGenerator
       are untouched, so Odyssey and Vanilla Gravship Expanded progression is
       unaffected. We are not taking anyone's rewards, only adding a reason to
       fly up.

       DROP SHAPE, per spec: roughly 30% one heart, 50% two, 20% three.
       Weights 3 / 5 / 2 give exactly that, averaging 1.9 per pull.

       COMBINED WITH the 0~1 glittership chunk on platforms (3 hearts each,
       ~50% of platforms), expected yield is roughly 3-4 hearts per orbital
       raid. Against ~25 total demand that is about 7 raids for the full
       gated tree - slightly generous versus the "closer to 10" target.

       TO TUNE: lower the weight-2 and weight-3 options here first. That
       moves the average without touching the chunk, which is the part that
       makes a raid feel like a haul.
       ==================================================================== -->

  <Operation Class="PatchOperationAdd" MayRequire="Ushanka.GlittertechExpansion">
    <xpath>/Defs/ThingSetMakerDef[defName="Reward_GravshipUpgrade"]/root/options</xpath>
    <value>
      <!-- ~30%: one heart -->
      <li>
        <weight>3</weight>
        <thingSetMaker Class="ThingSetMaker_Count">
          <fixedParams>
            <filter>
              <thingDefs>
                <li>USH_Glitterheart</li>
              </thingDefs>
            </filter>
            <countRange>1~1</countRange>
          </fixedParams>
        </thingSetMaker>
      </li>
      <!-- ~50%: two hearts -->
      <li>
        <weight>5</weight>
        <thingSetMaker Class="ThingSetMaker_Count">
          <fixedParams>
            <filter>
              <thingDefs>
                <li>USH_Glitterheart</li>
              </thingDefs>
            </filter>
            <countRange>2~2</countRange>
          </fixedParams>
        </thingSetMaker>
      </li>
      <!-- ~20%: three hearts, the good haul -->
      <li>
        <weight>2</weight>
        <thingSetMaker Class="ThingSetMaker_Count">
          <fixedParams>
            <filter>
              <thingDefs>
                <li>USH_Glitterheart</li>
              </thingDefs>
            </filter>
            <countRange>3~3</countRange>
          </fixedParams>
        </thingSetMaker>
      </li>
    </value>
  </Operation>

  <!-- Glitterite raids carry hearts too, so their orbital settlements are
       worth assaulting directly rather than only waiting for a scan. -->
  <Operation Class="PatchOperationAdd" MayRequire="Ushanka.GlittertechExpansion">
    <xpath>/Defs/ThingSetMakerDef[defName="Archinity_GlitteritesRaidLootMaker"]/root/fixedParams/filter/thingDefs</xpath>
    <value>
      <li>USH_Glitterheart</li>
    </value>
  </Operation>

</Patch>
