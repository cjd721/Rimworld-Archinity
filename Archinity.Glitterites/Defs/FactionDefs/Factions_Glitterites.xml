<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ====================================================================
       THE GLITTERITES

       The gate. Archon-seeded custodians running on glitterworld technology,
       left behind to make sure nothing climbs out of this system until it is
       strong enough to deserve to.

       PERMANENT ENEMY - deliberate, and load-bearing. Two reasons:

       1. Design. They are the final gate before ascension. A gate you can
          negotiate with is not a gate.

       2. Mechanics. GoodwillSituationWorker_PermanentEnemy pins max goodwill
          at -100 for the whole game. The alternative, naturalEnemy, sets a
          natural goodwill offset of -130, so it also trends hostile rather
          than drifting neutral - but it does not LOCK, and anything that
          nudges goodwill upward over a hundred-hour run could soften them.
          permanentEnemy removes them from diplomacy entirely: no peace
          talks, no trade, no gifts, no accidental thaw.

       SETTLEMENTS: orbit only. Whitelisting Surface as well would backfire -
       there is no per-layer settlement weight in FactionDef, so distribution
       follows raw tile count, and the surface (subdivisions 10) has orders
       of magnitude more tiles than orbit (6). They would end up a planetside
       faction with a few space stations, the exact inverse of the intent.

       Their surface presence comes instead from Ushanka's Glittertech
       Expansion quest sites, rebound to this faction in Patches/. Those
       generate 2-6 tiles from your colony, so the footprint is dynamic and
       always relevant rather than three static dots you may never visit.
       ==================================================================== -->

  <FactionDef ParentName="FactionBase">
    <defName>Archinity_Glitterites</defName>
    <label>glitterites</label>
    <description>They were here before the ancients, and they did not come from here.\n\nWhat the archons left behind was not a garrison. It was a threshold - a civilisation built out of glitterworld technology and given one standing instruction: let nothing leave this system that could not have taken the system by force.\n\nThe Glitterites do not conquer. They do not expand. They have held the same orbits for longer than any surviving record, running installations nobody built and nobody maintains, and they descend only when something below starts reaching upward. Their soldiers are overclocked past what a body should survive, and they field machines to spare themselves the trouble.\n\nThey are not evil, and they will not be reasoned with. They are a lock, and you are either the key or you are not.</description>
    <pawnSingular>glitterite</pawnSingular>
    <pawnsPlural>glitterites</pawnsPlural>
    <leaderTitle>threshold magistrate</leaderTitle>
    <categoryTag>Archinity_Glitterites</categoryTag>
    <fixedLeaderKinds>
      <li>Archinity_GL_Magistrate</li>
    </fixedLeaderKinds>

    <colorSpectrum>
      <li>(0.85, 0.83, 0.55)</li>
      <li>(0.95, 0.92, 0.72)</li>
    </colorSpectrum>
    <factionIconPath>World/WorldObjects/Expanding/Archinity_Glitterites</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

    <techLevel>Ultra</techLevel>
    <permanentEnemy>true</permanentEnemy>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>

    <!-- Floor on when they may raid at all. Ignorance Is Bliss does the real
         tech-band filtering (they are Ultra, so they stay out of the hostile
         pool until you are near that tier); this is an independent backstop
         so a settings mistake cannot drop an Ultra raid on a stone-age camp. -->
    <earliestRaidDays>400</earliestRaidDays>

    <settlementGenerationWeight>1.2</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>2000</configurationListOrderPriority>

    <layerWhitelist>
      <li>Orbit</li>
    </layerWhitelist>
    <arrivalLayerWhitelist>
      <li>Surface</li>
      <li>Orbit</li>
    </arrivalLayerWhitelist>
    <arrivalModeWhitelist>
      <li>EdgeDrop</li>
      <li>EdgeDropGroups</li>
      <li>CenterDrop</li>
      <li>RandomDrop</li>
    </arrivalModeWhitelist>
    <allowedArrivalTemperatureRange>-85~45</allowedArrivalTemperatureRange>

    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <canRequestTraders>false</canRequestTraders>
    <canRequestOrbitalTrader>false</canRequestOrbitalTrader>
    <canRequestMilitaryAid>false</canRequestMilitaryAid>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <autoFlee>false</autoFlee>

    <factionNameMaker>Archinity_NamerFactionGlitterites</factionNameMaker>
    <settlementNameMaker>Archinity_NamerSettlementGlitterites</settlementNameMaker>

    <!-- Engineered, not born. Genies dominate; no baseline stock to speak of. -->
    <xenotypeSet>
      <xenotypeChances>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.55</Genie>
        <Hussar MayRequire="Ludeon.RimWorld.Biotech">0.25</Hussar>
        <Highmate MayRequire="Ludeon.RimWorld.Biotech">0.05</Highmate>
      </xenotypeChances>
    </xenotypeSet>

    <hiddenIdeo>true</hiddenIdeo>
    <allowedCultures>
      <li>Astropolitan</li>
    </allowedCultures>
    <styles>
      <li MayRequire="Ludeon.RimWorld.Ideology">Techist</li>
    </styles>
    <structureMemeWeights>
      <Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">10</Structure_Archist>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">3</Structure_Ideological>
    </structureMemeWeights>

    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
      </li>
    </backstoryFilters>

    <caravanTraderKinds />
    <visitorTraderKinds />
    <baseTraderKinds />
    <orbitalTraderKinds />

    <raidLootMaker>Archinity_GlitteritesRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,      60)</li>
        <li>(700,   140)</li>
        <li>(1300,  220)</li>
        <li>(5000,  500)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0)</li>
        <li>(3000, 0)</li>
        <li>(6000, 1)</li>
        <li>(20000, 2)</li>
      </points>
    </raidCommonalityFromPointsCurve>

    <!-- Mixed human/machine forces. A Glitterite raid arrives as overclocked
         soldiers WITH mechs, not as one or the other - PawnGenOption is just
         (kind, weight), so listing mech kinds alongside humans in the same
         options block is what produces a combined-arms group.

         Vanilla mechs are the guaranteed backbone. Alpha Mechs entries are
         MayRequire-guarded, so dropping that mod thins the roster instead of
         breaking the faction. -->
    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Archinity_GL_Warden>10</Archinity_GL_Warden>
          <Archinity_GL_Lector>5</Archinity_GL_Lector>
          <USH_AncientGlittertechSoldier MayRequire="Ushanka.GlittertechExpansion">8</USH_AncientGlittertechSoldier>
          <Mech_Scyther>6</Mech_Scyther>
          <Mech_Lancer>6</Mech_Lancer>
          <Mech_Pikeman>4</Mech_Pikeman>
          <Mech_CentipedeBlaster>3</Mech_CentipedeBlaster>
          <Mech_CentipedeGunner>3</Mech_CentipedeGunner>
          <Mech_CentipedeBurner>2</Mech_CentipedeBurner>
          <Mech_Militor MayRequire="Ludeon.RimWorld.Biotech">6</Mech_Militor>
          <Mech_Legionary MayRequire="Ludeon.RimWorld.Biotech">4</Mech_Legionary>
          <Mech_Scorcher MayRequire="Ludeon.RimWorld.Biotech">3</Mech_Scorcher>
          <Mech_Centurion MayRequire="Ludeon.RimWorld.Biotech">2</Mech_Centurion>
          <AM_Daggersnout MayRequire="sarg.alphamechs">4</AM_Daggersnout>
          <AM_Aura        MayRequire="sarg.alphamechs">3</AM_Aura>
          <AM_Phalanx     MayRequire="sarg.alphamechs">3</AM_Phalanx>
          <AM_Fireworm    MayRequire="sarg.alphamechs">2</AM_Fireworm>
          <AM_Goliath     MayRequire="sarg.alphamechs">1</AM_Goliath>
          <AM_Siegebreaker MayRequire="sarg.alphamechs">1</AM_Siegebreaker>
          <AM_Demolisher  MayRequire="sarg.alphamechs">1</AM_Demolisher>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Archinity_GL_Technician>6</Archinity_GL_Technician>
          <Archinity_GL_Warden>10</Archinity_GL_Warden>
          <Archinity_GL_Lector>6</Archinity_GL_Lector>
          <USH_AncientGlittertechSoldier MayRequire="Ushanka.GlittertechExpansion">8</USH_AncientGlittertechSoldier>
          <Mech_Scyther>5</Mech_Scyther>
          <Mech_Lancer>5</Mech_Lancer>
          <Mech_CentipedeBlaster>3</Mech_CentipedeBlaster>
          <Mech_CentipedeGunner>2</Mech_CentipedeGunner>
          <Mech_Militor MayRequire="Ludeon.RimWorld.Biotech">5</Mech_Militor>
          <AM_Phalanx MayRequire="sarg.alphamechs">3</AM_Phalanx>
          <AM_Aura    MayRequire="sarg.alphamechs">2</AM_Aura>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

  <ThingSetMakerDef>
    <defName>Archinity_GlitteritesRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>Gold</li>
            <li>Plasteel</li>
            <li>ComponentSpacer</li>
            <li>MedicineUltratech</li>
            <li>Uranium</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

</Defs>
