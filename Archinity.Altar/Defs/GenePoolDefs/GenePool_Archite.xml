        <tier>3</tier>
        <category>Survival</category>
        <reserved>true</reserved>
      </li>
      <!-- The Descent Engine quest returns this, gated on Xenogermination.
           Stripped from the starting xenotype so that for ~400 days there is
           no way at all to share what the founders are. -->
      <li>
        <gene>XenogermReimplanter</gene>
        <tier>4</tier>
        <category>Social</category>
        <reserved>true</reserved>
      </li>

