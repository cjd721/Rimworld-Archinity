        <reserved>true</reserved>
      </li>
      <!-- Full EMP immunity plus an offensive EMP burst. This is what keeps
           the archoplate's shield up against mechanoids, so it is the late
           reward that makes the armour usable in the fights it is for. -->
      <li MayRequire="vanillaquestsexpanded.ancients">
        <gene>VQEA_Electromagnetized</gene>
        <tier>4</tier>
        <category>Survival</category>
        <reserved>true</reserved>
      </li>
      <li MayRequire="ludeon.rimworld.odyssey">
