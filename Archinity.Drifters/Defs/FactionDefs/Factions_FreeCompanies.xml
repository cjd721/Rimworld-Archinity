<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ====================================================================
       STARJACK FREE COMPANIES

       Built on Odyssey's TradersGuild skeleton, but with the switches Ludeon
       deliberately left off. TradersGuild is a merchant fixture: it cannot
       send military aid, cannot generate quest sites, and has no reason to
       matter to you beyond its stock list.

       The Free Companies are a real power. You can ally with them and call
       them to a fight, they hand out work, and you can go to war with them
       and take their stations.

       HOSTILITY: neutral by default, hostile-capable. permanentEnemy and
       naturalEnemy are both deliberately absent, so they start neutral and
       goodwill moves normally in both directions.

       LAYER: they live in orbit only. neutralArrivalLayerBlacklist keeps
       them off the surface while relations are neutral, which matters a
       great deal in a playthrough that spends its first several years in
       the neolithic era - a spacer faction must not go wandering into a
       stone-age camp. Once hostile, Surface is on the arrival whitelist and
       they can and will come down after you.
       ==================================================================== -->

  <FactionDef ParentName="FactionBase">
    <defName>Archinity_FreeCompanies</defName>
    <label>starjack free companies</label>
    <description>Not a nation. Not even really an alliance. The Free Companies are a few hundred independent crews who agree on exactly two things: that a ship belongs to the people aboard it, and that nobody planetside gets to tell them otherwise.\n\nMost of them are starjacks - engineered for the void, hollow-boned and vacuum-tolerant, born and buried without ever standing on a world. They charter, salvage, escort, and occasionally raid. A company that dislikes a contract simply leaves, and a company that dislikes another company sometimes settles it with guns.\n\nThey will fight alongside anyone who pays and means it. They will not take orders, and they do not forgive being shot at.</description>
    <pawnSingular>free companion</pawnSingular>
    <pawnsPlural>free companions</pawnsPlural>
    <leaderTitle>free captain</leaderTitle>
    <categoryTag>Archinity_FreeCompanies</categoryTag>
    <fixedLeaderKinds>
      <li>Archinity_FC_FreeCaptain</li>
    </fixedLeaderKinds>

    <colorSpectrum>
      <li>(0.30, 0.62, 0.66)</li>
      <li>(0.42, 0.76, 0.72)</li>
    </colorSpectrum>
    <factionIconPath>World/WorldObjects/Expanding/Archinity_FreeCompanies</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

    <techLevel>Spacer</techLevel>

    <!-- Worldgen presence. TradersGuild sits at 1; slightly above it so the
         Free Companies read as the larger orbital presence without crowding
         the Guild off the layer entirely. -->
    <settlementGenerationWeight>1.4</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>2</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>85</configurationListOrderPriority>

    <!-- Orbit only. -->
    <layerWhitelist>
      <li>Orbit</li>
    </layerWhitelist>
    <arrivalLayerWhitelist>
      <li>Surface</li>
      <li>Orbit</li>
    </arrivalLayerWhitelist>
    <neutralArrivalLayerBlacklist>
      <li>Surface</li>
    </neutralArrivalLayerBlacklist>
    <arrivalModeWhitelist>
      <li>EdgeDrop</li>
      <li>EdgeDropGroups</li>
      <li>CenterDrop</li>
      <li>RandomDrop</li>
    </arrivalModeWhitelist>
    <allowedArrivalTemperatureRange>-85~45</allowedArrivalTemperatureRange>

    <!-- The differentiators from TradersGuild. -->
    <canRequestMilitaryAid>true</canRequestMilitaryAid>
    <canGenerateQuestSites>true</canGenerateQuestSites>
    <canRequestOrbitalTrader>true</canRequestOrbitalTrader>
    <canRequestTraders>false</canRequestTraders>  <!-- they do not make planetfall to trade -->
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>

    <factionNameMaker>Archinity_NamerFactionFreeCompanies</factionNameMaker>
    <settlementNameMaker>Archinity_NamerSettlementFreeCompanies</settlementNameMaker>

    <!-- Starjack-dominant. Contained to this faction: the xenotype does not
         leak into planetside factions, and Odyssey's own TradersGuild and
         Salvagers keep their vanilla starjack rates untouched. -->
    <xenotypeSet>
      <xenotypeChances>
        <Starjack MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">0.75</Starjack>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.08</Genie>
        <Hussar MayRequire="Ludeon.RimWorld.Biotech">0.04</Hussar>
      </xenotypeChances>
    </xenotypeSet>

    <allowedCultures>
      <li>Astropolitan</li>
    </allowedCultures>
    <styles>
      <li MayRequire="Ludeon.RimWorld.Ideology">Techist</li>
    </styles>
    <requiredMemes>
      <li>Shipborn</li>
    </requiredMemes>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AnimalPersonhood</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Rancher</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Darkness</li>
      <!-- No unified government, so no god-emperors and no supremacy. -->
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
    </disallowedMemes>
    <structureMemeWeights>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">10</Structure_Ideological>
      <Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">4</Structure_Archist>
      <Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">2</Structure_TheistAbstract>
      <Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">1</Structure_TheistEmbodied>
    </structureMemeWeights>

    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
        <commonality>0.95</commonality>
      </li>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
        <commonality>0.05</commonality>
      </li>
    </backstoryFilters>

    <caravanTraderKinds />
    <visitorTraderKinds />
    <baseTraderKinds />
    <orbitalTraderKinds>
      <li>Orbital_BulkGoods</li>
      <li>Orbital_CombatSupplier</li>
      <li>Orbital_Exotic</li>
    </orbitalTraderKinds>

    <raidLootMaker>Archinity_FreeCompaniesRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>

    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Archinity_FC_Gunner>10</Archinity_FC_Gunner>
          <Archinity_FC_Corsair>7</Archinity_FC_Corsair>
          <Archinity_FC_Heavy>4</Archinity_FC_Heavy>
          <Archinity_FC_Voidwright>4</Archinity_FC_Voidwright>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Archinity_FC_Deckhand>20</Archinity_FC_Deckhand>
          <Archinity_FC_Child MayRequire="Ludeon.RimWorld.Biotech">8</Archinity_FC_Child>
          <Archinity_FC_Gunner>10</Archinity_FC_Gunner>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Archinity_FC_Deckhand>10</Archinity_FC_Deckhand>
          <Archinity_FC_Gunner>10</Archinity_FC_Gunner>
          <Archinity_FC_Corsair>7</Archinity_FC_Corsair>
          <Archinity_FC_Voidwright>8</Archinity_FC_Voidwright>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

  <ThingSetMakerDef>
    <defName>Archinity_FreeCompaniesRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>MedicineIndustrial</li>
            <li>ComponentIndustrial</li>
            <li>ComponentSpacer</li>
            <li>MealSurvivalPack</li>
            <li>Neutroamine</li>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

</Defs>
